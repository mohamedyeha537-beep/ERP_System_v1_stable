# =============================================================================
# إعدادات نقطة البيع — انسخ هذا الملف إلى `.env` وعدّل القيم
# =============================================================================

# --- قاعدة البيانات (مطلوب) ---
# انسخ هذا الملف إلى `.env` — بدون DATABASE_URL لن يشتغل التطبيق.

# تطوير محلي — SQLite
# DATABASE_URL=sqlite:///./pos.db

# تطوير محلي — MySQL عبر XAMPP (موصى به بدون Docker) — setup-mysql-xampp.bat
DATABASE_URL=mysql+pymysql://pos_user:pos_local_dev@127.0.0.1:3306/pos_db?charset=utf8mb4

# بديل — MySQL عبر Docker — setup-mysql-local.bat
# DATABASE_URL=mysql+pymysql://pos_user:pos_local_dev@127.0.0.1:3306/pos_db?charset=utf8mb4

# إنتاج VPS — MySQL/MariaDB
# DATABASE_URL=mysql+pymysql://pos_user:STRONG_PASSWORD@127.0.0.1:3306/pos_db?charset=utf8mb4

# بديل — PostgreSQL
# DATABASE_URL=postgresql+psycopg2://pos_user:STRONG_PASSWORD@127.0.0.1:5432/pos_db

# تجميع الاتصالات (MySQL / PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800

# --- أمان ---
SECRET_KEY=change-me-in-production-use-long-random-string
SESSION_COOKIE_NAME=pos_session
INTEGRATION_API_KEY=dev-integration-key-change-me

# --- حساب المدير الافتراضي (يُنشأ عند أول تشغيل إن لم يوجد مستخدمون) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- بذور تجريبية (عطّلها على الإنتاج) ---
SEED_DEMO_USERS=false
DEMO_USERS_PASSWORD=demo123

# --- تشغيل السيرفر ---
# POS_PORT=8011
# POS_RELOAD=0

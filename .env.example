# =============================================================================
# إعدادات نقطة البيع — انسخ هذا الملف إلى `.env` وعدّل القيم
# =============================================================================

# --- قاعدة البيانات (مطلوب) ---
# انسخ هذا الملف إلى `.env` — بدون DATABASE_URL لن يشتغل التطبيق.

# تطوير محلي — SQLite
# DATABASE_URL=sqlite:///./pos.db

# تطوير محلي — MySQL عبر XAMPP (موصى به بدون Docker) — setup-mysql-xampp.bat
DATABASE_URL=mysql+pymysql://pos_user:pos_local_dev@127.0.0.1:3306/pos_db?charset=utf8mb4

# بديل — MySQL عبر Docker — setup-mysql-local.bat
# DATABASE_URL=mysql+pymysql://pos_user:pos_local_dev@127.0.0.1:3306/pos_db?charset=utf8mb4

# إنتاج VPS — MySQL/MariaDB
# DATABASE_URL=mysql+pymysql://pos_user:STRONG_PASSWORD@127.0.0.1:3306/pos_db?charset=utf8mb4

# بديل — PostgreSQL
# DATABASE_URL=postgresql+psycopg2://pos_user:STRONG_PASSWORD@127.0.0.1:5432/pos_db

# تجميع الاتصالات (MySQL / PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800

# --- أمان ---
# استخدم openssl rand -hex 32 أو أداة مشابهة لتوليد مفتاح سري قوي (≥ 32 حرف)
SECRET_KEY=change-me-in-production-use-long-random-string
SESSION_COOKIE_NAME=pos_session
SESSION_SAMESITE=lax
SESSION_MAX_AGE=86400
SESSION_HTTPS_ONLY=false
# في الإنتاج: true
INTEGRATION_API_KEY=dev-integration-key-change-me

# --- حساب المدير الافتراضي (يُنشأ عند أول تشغيل إن لم يوجد مستخدمون) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- بذور تجريبية (عطّلها على الإنتاج) ---
SEED_DEMO_USERS=false
DEMO_USERS_PASSWORD=demo123

# --- تشغيل السيرفر ---
# POS_PORT=8011
# POS_RELOAD=0
# إظهار وثائق/مخطط OpenAPI (false في الإنتاج)
# SHOW_DOCS=false

# --- الرابط العام (SEO / واتساب / خريطة الموقع) — لكل سيرفر قيمة مختلفة ---
# تجريب:  https://pos.baytak.ly
# إنتاج:  https://baytak.baytak.ly
# PUBLIC_BASE_URL=https://baytak.baytak.ly
# إن وُجدت هنا تتقدّم على حقل «الرابط العام» في /admin/settings

# --- SEO Agent Integration (n8n خارجي — لا تضع مفاتيح حقيقية في Git) ---
# SEO_AGENT_ENABLED=true
# SEO_ENVIRONMENT=staging
# SEO_AGENT_API_KEY=replace-with-long-random-secret
# SEO_ALLOW_AUTO_APPLY=false
# SEO_REQUIRE_PRODUCTION_APPROVAL=true
# SEO_PUBLIC_BASE_URL=https://pos.baytak.ly
# SEO_N8N_WEBHOOK_URL=
# SEO_N8N_CALLBACK_SECRET=
# إنتاج:
# SEO_ENVIRONMENT=production
# SEO_PUBLIC_BASE_URL=https://baytak.baytak.ly
# SEO_ALLOW_AUTO_APPLY=false
# SEO_REQUIRE_PRODUCTION_APPROVAL=true

# --- غرفة وكلاء التسويق (مرحلة 1 — محتوى + موافقة؛ النشر اليدوي) ---
# MARKETING_N8N_WEBHOOK_URL=
# MARKETING_AGENT_API_KEY=replace-with-long-random-secret
# أو الصق مفتاح fal.ai من إعدادات الغرفة في الواجهة (موصى به للصور)
# FAL_KEY=
# Higgsfield (صور احتياطي + فيديو) — غالباً key_id:key_secret
# HF_KEY=
# مدير حملات فيسبوك (اختياري — أو من واجهة الإعدادات)
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_123456789
# أو استخدم نفس مفاتيح محادثة الويب (web_chat_ai_*) من الإعدادات للنصوص


# --- أدوات MySQL للنسخ الاحتياطي/الاستعادة (اختياري) ---
# إن لم تكن mysqldump/mysql على PATH (شائع مع XAMPP على Windows):
# MYSQL_BIN=C:\xampp\mysql\bin
# أو مسار كامل لأداة واحدة:
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
# MYSQL_PATH=C:\xampp\mysql\bin\mysql.exe

# ========== عمل أوفلاين كامل + مزامنة عند عودة الإنترنت ==========
# التشغيل المحلي (مبيعات/حجوزات/طباعة) يعمل بدون إنترنت دائماً عبر قاعدة البيانات المحلية.
# المزامنة السحابية اختيارية: عند تفعيلها تُصفّ التغييرات محلياً أثناء الانقطاع وتُدفع تلقائياً عند عودة الاتصال.
#
# SYNC_ENABLED=false
# SYNC_SITE_ID=bayatak-main
# ONLINE_SYNC_URL=https://your-central-server.com
# ONLINE_SYNC_API_KEY=change-me-to-strong-random-key
# SYNC_INTERVAL_SECONDS=60
# SYNC_BATCH_SIZE=100
# SYNC_PULL_ENABLED=true
